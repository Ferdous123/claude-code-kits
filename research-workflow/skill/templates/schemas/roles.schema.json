        "extract": {
          "type": "object",
          "description": "Role entry",
          "additionalProperties": false,
          "properties": {
            "assigned": {
              "type": "string",
              "enum": [
                "claude",
                "local",
                "person",
                "none"
              ],
              "description": "Who does this role now"
            },
            "primary": {
              "type": [
                "string",
                "null"
              ],
              "description": "Model tag for the first local pass"
            },
            "secondary": {
              "type": [
                "string",
                "null"
              ],
              "description": "Model tag (different family) for the second pass"
            },
            "evidence": {
              "type": "array",
              "description": "Run ids from evals/results.jsonl that earned the assignment",
              "items": {
                "type": "string",
                "description": "run id"
              }
            },
            "stale": {
              "type": "boolean",
              "description": "True when the machine changed or a model was removed: retest before use"
            },
            "note": {
              "type": "string",
              "description": "Plain note"
            }
          },
          "required": [
            "assigned",
            "primary",
