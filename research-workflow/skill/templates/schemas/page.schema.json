{
  "type": "object",
  "description": "parsed/<paper_id>/pages/pNNNN.json: one parsed page",
  "additionalProperties": false,
  "properties": {
    "paper_id": {
      "type": "string",
      "description": "Paper id"
    },
    "page": {
      "type": "integer",
      "description": "Page number from 1",
      "minimum": 1
    },
    "width": {
      "type": [
        "number",
        "null"
      ],
      "description": "Page width in points (null for text-only sources)"
    },
    "height": {
      "type": [
        "number",
        "null"
      ],
      "description": "Page height in points"
    },
    "rotation": {
      "type": "integer",
      "description": "Page rotation in degrees"
    },
    "text": {
      "type": "string",
      "description": "Full page text in reading order, blocks joined by a blank line"
    },
    "text_sha256": {
      "type": "string",
      "description": "SHA-256 of text"
    },
    "chars": {
      "type": "integer",
      "description": "Length of text",
      "minimum": 0
    },
    "blocks": {
      "type": "array",
      "description": "Blocks in order",
      "items": {
        "type": "object",
        "description": "A block of text on a page",
        "additionalProperties": false,
        "properties": {
          "block_id": {
            "type": "string",
            "description": "Block id, e.g. P0001-p0003-b012"
          },
          "start": {
            "type": "integer",
            "description": "Start offset in the page text",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "description": "End offset in the page text",
            "minimum": 0
          },
          "bbox": {
            "type": [
              "array",
              "null"
            ],
            "description": "x0,y0,x1,y1 in PDF points, origin top-left, rotation applied; null for text-only sources",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "zone": {
            "type": "string",
            "enum": [
              "title_block",
              "abstract",
              "heading",
              "body",
              "related_work",
              "caption",
              "table",
              "equation",
              "algorithm",
              "footnote",
              "bibliography",
              "appendix",
              "unknown"
            ],
            "description": "Document zone"
          },
          "zone_source": {
            "type": "string",
            "enum": [
              "heuristic",
              "user"
            ],
            "description": "How the zone was set"
          }
        },
        "required": [
          "block_id",
          "start",
          "end",
          "bbox",
          "zone",
          "zone_source"
        ]
      }
    },
    "backend": {
      "type": "string",
      "description": "Extractor used (pymupdf, text)"
    },
    "parser_version": {
      "type": "string",
      "description": "Version string of the extractor"
    },
    "extracted_on": {
      "type": "string",
      "description": "When",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  },
  "required": [
    "paper_id",
    "page",
    "text",
    "text_sha256",
    "chars",
    "blocks",
    "backend",
    "parser_version",
    "extracted_on"
  ],
  "$id": "page",
  "title": "page"
}
